# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
COMPANY_NAME=Your Company

# --- Models (defaults shown) ---
# MODEL_ORCHESTRATOR=claude-opus-5-5
# MODEL_WORKER=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5

# --- Salesforce (leave blank to use the built-in local CRM) ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# "login" for production, "test" for a sandbox org
SF_DOMAIN=login

# --- Email (leave SMTP_HOST blank for dry-run: approved emails are logged, not sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=sales@yourcompany.com
PHYSICAL_ADDRESS=Your registered office address (required by CAN-SPAM)

# --- Guardrails ---
DAILY_SEND_CAP=200
PER_DOMAIN_DAILY_CAP=3

# --- Security (set both in any shared deployment) ---
API_TOKEN=
WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000

# Generated decks/proposals colour (hex) and output folder
BRAND_COLOR=3B5BDB
# GENERATED_DIR=/data/generated

# Automatic buying-signal scans every N days (0 = off; costs AI + web search)
SIGNAL_SCAN_INTERVAL_DAYS=0

# Quarterly revenue target for forecast attainment/coverage (0 = not set)
QUARTERLY_TARGET=0
# Automatic deal reviews + forecast + learning loop every N days (0 = off; costs AI spend)
REVIEW_INTERVAL_DAYS=0

# --- Customer context integrations ---
SLACK_SIGNING_SECRET=
ZOOM_WEBHOOK_SECRET=
CONTEXT_RETENTION_DAYS=90
MEETING_PREP_HOURS_BEFORE=24
PERSONALISATION_THRESHOLD=60

# --- Connected accounts (Phase B) ---
# Required before anyone connects a mailbox: encrypts stored OAuth tokens. Use a long random value.
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
# Google Cloud OAuth client (Gmail, Calendar, Meet). Redirect URI: {PUBLIC_BASE_URL}/api/integrations/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app (Outlook, Calendar, Teams transcripts). Redirect URI: {PUBLIC_BASE_URL}/api/integrations/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
GONG_ACCESS_KEY=
GONG_ACCESS_SECRET=
# Slack approvals channel + /revenueos command (bot scope: chat:write)
SLACK_BOT_TOKEN=
SLACK_APPROVALS_CHANNEL=
# Share of eligible outbound leads held back as a control group
HOLDOUT_PCT=0.2

# --- Any CRM (Phase C) ---
# local | salesforce | hubspot | dynamics (default: salesforce if SF_* set, else local)
CRM_PROVIDER=
HUBSPOT_TOKEN=
DYNAMICS_URL=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
# Optional JSON overrides, e.g. {"deal_stage": {"proposal": "contractsent"}}
CRM_FIELD_MAP={}
# Web app: which CRM domains may frame the side panel (/embed)
# EMBED_ALLOWED_ORIGINS='self' https://*.lightning.force.com https://app.hubspot.com https://*.dynamics.com

# --- More CRMs (Phase D) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# ZOHO_API_DOMAIN=https://www.zohoapis.eu
PIPEDRIVE_TOKEN=
PIPEDRIVE_DOMAIN=api.pipedrive.com
# Client workspaces need SECRET_KEY (settings secrets are encrypted with it). Create the owner account at /login.
